{ "manifest_version": 3, "name": "Browser Dark Mode", "version": "0.1.0",
  "description": "Dark mode for every website, with automatic detection of built-in dark themes.",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_title": "Browser Dark Mode", "default_popup": "popup/popup.html", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "background": { "service_worker": "background.js" },
  "content_scripts": [ { "matches": ["<all_urls>"], "js": ["lib/api.js", "vendor/darkreader.js", "lib/settings.js", "detector.js", "content.js"], "run_at": "document_start", "all_frames": true, "match_about_blank": true } ],
  "permissions": ["storage"], "host_permissions": ["<all_urls>"] }
